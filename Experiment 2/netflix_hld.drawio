1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="840" y="200" width="190" height="65" as="geometry"/></mxCell><mxCell id="rc" value="Recommendation Service&lt;br&gt;Personalized rows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1070" y="200" width="190" height="65" as="geometry"/></mxCell><mxCell id="ud" value="User DB&lt;br&gt;PostgreSQL" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="840" y="310" width="190" height="65" as="geometry"/></mxCell><mxCell id="cd" value="Content DB&lt;br&gt;PostgreSQL" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1070" y="310" width="190" height="65" as="geometry"/></mxCell><mxCell id="pd" value="Progress / History DB&lt;br&gt;Cassandra / DynamoDB" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="840" y="410" width="190" height="65" as="geometry"/></mxCell><mxCell id="rd" value="Recommendation Store&lt;br&gt;Redis / KV" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1070" y="410" width="190" height="65" as="geometry"/></mxCell><mxCell id="k" value="KAFKA / EVENT BUS&lt;br&gt;Watch • Search • Like • Complete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="550" width="430" height="80" as="geometry"/></mxCell><mxCell id="ml" value="ML PIPELINE&lt;br&gt;Features → Models → Ranking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="550" width="260" height="80" as="geometry"/></mxCell><mxCell id="dl" value="DATA LAKE / ANALYTICS&lt;br&gt;Offline metrics • Training" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="680" width="300" height="80" as="geometry"/></mxCell><mxCell id="key" value="KEY RULE&lt;br&gt;&lt;b&gt;API servers authorize.&lt;/b&gt;&lt;br&gt;&lt;b&gt;CDN delivers video bytes.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="850" y="680" width="300" height="80" as="geometry"/></mxCell><mxCell id="e1" value="video" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="c" target="cdn"/><mxCell id="e2" value="API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="c" target="gw"/><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="gw" target="u"/><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="gw" target="co"/><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="gw" target="pb"/><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="gw" target="rc"/><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="u" target="ud"/><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="co" target="cd"/><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="pb" target="pd"/><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="rc" target="rd"/><mxCell id="e11" value="events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="pb" target="k"/><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="k" target="ml"/><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="k" target="dl"/><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="ml" target="rd"/><mxCell id="e15" value="playback token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="pb" target="cdn"/></root></mxGraphModel></diagram><diagram id="page2" name="02 - Playback Flow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Playback Flow — Click Play → Video" style="text;html=1;fontSize=24;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="350" y="20" width="900" height="50" as="geometry"/></mxCell><mxCell id="s1" value="1. USER&lt;br&gt;Click Play" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="160" width="160" height="70" as="geometry"/></mxCell><mxCell id="s2" value="2. API GATEWAY&lt;br&gt;Authenticate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="160" width="180" height="70" as="geometry"/></mxCell><mxCell id="s3" value="3. PLAYBACK SERVICE&lt;br&gt;Check plan + region" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="510" y="160" width="220" height="70" as="geometry"/></mxCell><mxCell id="s4" value="4. RESPONSE&lt;br&gt;Signed token + manifest URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="790" y="160" width="220" height="70" as="geometry"/></mxCell><mxCell id="s5" value="5. CDN&lt;br&gt;Fetch manifest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1070" y="160" width="190" height="70" as="geometry"/></mxCell><mxCell id="s6" value="6. CDN&lt;br&gt;Return video segments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1070" y="310" width="190" height="70" as="geometry"/></mxCell><mxCell id="s7" value="7. PLAYER&lt;br&gt;ABR selects quality" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="310" width="220" height="70" as="geometry"/></mxCell><mxCell id="s8" value="8. PROGRESS EVENTS&lt;br&gt;Kafka → Progress DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="510" y="310" width="220" height="70" as="geometry"/></mxCell><mxCell id="s9" value="9. ASYNC PROCESSING&lt;br&gt;Analytics + Recommendations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="230" y="310" width="220" height="70" as="geometry"/></mxCell><mxCell id="why" value="WHY?&lt;br&gt;Video traffic is enormous, so application servers never carry the video stream. CDN handles bandwidth; Kafka handles asynchronous user events." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="300" y="480" width="720" height="100" as="geometry"/></mxCell><mxCell id="p1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="s1" target="s2"/><mxCell id="p2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="s2" target="s3"/><mxCell id="p3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="s3" target="s4"/><mxCell id="p4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="s4" target="s5"/><mxCell id="p5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="s5" target="s6"/><mxCell id="p6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="s6" target="s7"/><mxCell id="p7" value="periodic" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="s7" target="s8"/><mxCell id="p8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="s8" target="s9"/></root></mxGraphModel></diagram><diagram id="page3" name="03 - Content Pipeline"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Content Ingestion → Transcoding → CDN" style="text;html=1;fontSize=24;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="350" y="20" width="900" height="50" as="geometry"/></mxCell><mxCell id="a1" value="1. STUDIO&lt;br&gt;Upload master video" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="180" width="190" height="75" as="geometry"/></mxCell><mxCell id="a2" value="2. UPLOAD SERVICE&lt;br&gt;Validate + register" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="180" width="190" height="75" as="geometry"/></mxCell><mxCell id="a3" value="3. OBJECT STORAGE&lt;br&gt;Original master" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="530" y="180" width="190" height="75" as="geometry"/></mxCell><mxCell id="a4" value="4. TRANSCODING QUEUE&lt;br&gt;Async job" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="770" y="180" width="190" height="75" as="geometry"/></mxCell><mxCell id="a5" value="5. TRANSCODING WORKERS&lt;br&gt;240p • 480p • 720p • 1080p • 4K" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1010" y="160" width="280" height="115" as="geometry"/></mxCell><mxCell id="a6" value="6. PROCESSED STORAGE&lt;br&gt;HLS / DASH segments + manifests" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1010" y="350" width="280" height="85" as="geometry"/></mxCell><mxCell id="a7" value="7. CDN&lt;br&gt;Cache at edge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="550" width="250" height="80" as="geometry"/></mxCell><mxCell id="a8" value="8. CONTENT DB&lt;br&gt;Metadata + manifest refs" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="300" y="550" width="250" height="80" as="geometry"/></mxCell><mxCell id="a9" value="9. PLAYER&lt;br&gt;Requests segments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="550" width="200" height="80" as="geometry"/></mxCell><mxCell id="a10" value="10. ABR&lt;br&gt;Switch quality dynamically" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="550" width="280" height="80" as="geometry"/></mxCell><mxCell id="a1e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="a1" target="a2"/><mxCell id="a2e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="a2" target="a3"/><mxCell id="a3e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="a3" target="a4"/><mxCell id="a4e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="a4" target="a5"/><mxCell id="a5e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="a5" target="a6"/><mxCell id="a6e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="a6" target="a7"/><mxCell id="a2d" value="metadata" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="a2" target="a8"/><mxCell id="a9e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="a9" target="a7"/><mxCell id="a7e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="a7" target="a10"/></root></mxGraphModel></diagram><diagram id="page4" name="04 - Data &amp; Estimates"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Data Model + Estimation + Trade-offs" style="text;html=1;fontSize=24;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="350" y="20" width="900" height="50" as="geometry"/></mxCell><mxCell id="d1" value="users&lt;br&gt;&lt;b&gt;PK user_id&lt;/b&gt;&lt;br&gt;email, password_hash, country, status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="50" y="120" width="240" height="100" as="geometry"/></mxCell><mxCell id="d2" value="profiles&lt;br&gt;&lt;b&gt;PK profile_id&lt;/b&gt;&lt;br&gt;FK user_id, name, maturity_level" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="350" y="120" width="240" height="100" as="geometry"/></mxCell><mxCell id="d3" value="content&lt;br&gt;&lt;b&gt;PK content_id&lt;/b&gt;&lt;br&gt;title, type, duration, release_date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="650" y="120" width="240" height="100" as="geometry"/></mxCell><mxCell id="d4" value="episodes&lt;br&gt;&lt;b&gt;PK episode_id&lt;/b&gt;&lt;br&gt;FK season_id, episode_number" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="950" y="120" width="240" height="100" as="geometry"/></mxCell><mxCell id="d5" value="watch_progress&lt;br&gt;&lt;b&gt;PK (profile_id, content_id)&lt;/b&gt;&lt;br&gt;position_seconds, updated_at" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="180" y="300" width="300" height="100" as="geometry"/></mxCell><mxCell id="d6" value="watchlist&lt;br&gt;&lt;b&gt;PK (profile_id, content_id)&lt;/b&gt;&lt;br&gt;added_at" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="560" y="300" width="260" height="100" as="geometry"/></mxCell><mxCell id="d7" value="video_assets&lt;br&gt;&lt;b&gt;PK asset_id&lt;/b&gt;&lt;br&gt;content_id, resolution, bitrate, codec, manifest_url" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="870" y="300" width="330" height="100" as="geometry"/></mxCell><mxCell id="est" value="CAPACITY ASSUMPTIONS&lt;br&gt;&lt;br&gt;50M DAU × 1.5 sessions/day ≈ 75M sessions/day&lt;br&gt;Peak planning ≈ 10K playback starts/sec&lt;br&gt;10M concurrent × 5 Mbps ≈ &lt;b&gt;50 Tbps&lt;/b&gt;&lt;br&gt;~900 TB original video → ~2.7 PB+ processed&lt;br&gt;~500M watch events/day → ~250 GB/day raw events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="50" y="470" width="700" height="300" as="geometry"/></mxCell><mxCell id="tr" value="TRADE-OFFS&lt;br&gt;&lt;br&gt;Strong consistency: subscription/payment&lt;br&gt;Eventual consistency: recommendations/trending/analytics&lt;br&gt;CDN: video delivery&lt;br&gt;Object storage: video source + segments&lt;br&gt;Kafka: asynchronous events&lt;br&gt;Cassandra/DynamoDB: high-volume progress/history&lt;br&gt;Search index: text search" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="470" width="450" height="300" as="geometry"/></mxCell><mxCell id="d1e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="d1" target="d2"/><mxCell id="d2e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="d2" target="d5"/><mxCell id="d3e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="d3" target="d7"/><mxCell id="d4e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="d3" target="d4"/><mxCell id="d5e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="d5" target="d6"/></root></mxGraphModel></diagram></mxfile>